<Window x:Class="Viewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Viewer"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="828.67" DataContext="{Binding RelativeSource={RelativeSource Self}}">
    <Window.Resources>
        <local:AccountsList x:Key="accounts"/>
        <local:ContestsList x:Key="contests"/>
        <local:TasksList x:Key="tasks"/>
        <Style x:Key="MyContainer" TargetType="{x:Type ListViewItem}">

            <Setter Property="Margin" Value="0,1,0,0"/>
            <Setter Property="Height" Value="21"/>

            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=Solved}" Value="True">
                    <Setter Property="Background" Value="LightSeaGreen"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="0,0,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <ListView Grid.Column="1" Grid.Row="0" HorizontalAlignment="Stretch" Name="listViewMoveList" VerticalAlignment="Top" SelectionMode="Single" ItemsSource="{Binding Source={StaticResource accounts}}" IsEnabled="True">
            <ListView.ContextMenu>
                <ContextMenu x:Name="accountsContextMenu">
                    <MenuItem Header="Copy username" Click="MenuItem_Click"/>
                    <MenuItem Header="Copy password" Click="MenuItem_Click_1"/>
                </ContextMenu>
            </ListView.ContextMenu>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Username" DisplayMemberBinding="{Binding Path=Username}"  Width="180" />
                    <GridViewColumn Header="Password"  DisplayMemberBinding="{Binding Path=Password}" Width="100" />
                </GridView>
            </ListView.View>
        </ListView>
        <ListView Grid.Column="1" Grid.Row="1" HorizontalAlignment="Stretch" Name="listViewContestsList" VerticalAlignment="Top" SelectionMode="Single" ItemsSource="{Binding Source={StaticResource contests}}" IsEnabled="True">
            <ListView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Copy URL" Click="MenuItem_Click_2"/>
                    <MenuItem Header="Login..." Click="MenuItem_Click_3"/>
                </ContextMenu>
            </ListView.ContextMenu>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Path=Name}" Width="280"/>
                </GridView>
            </ListView.View>
        </ListView>
        <Grid Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBox x:Name="filterBox" FontSize="16" Height="auto" Margin="0,0,0,0" VerticalAlignment="Stretch" TextChanged="filterBox_TextChanged" HorizontalAlignment="Stretch" Grid.Row="0" Grid.Column="0"/>
            <UniformGrid Rows="2" Columns="2" Grid.Row="0" Grid.Column="1" Margin="10,0,10,0">
                <TextBlock Text="Filter username " VerticalAlignment="Center"/>
                <CheckBox x:Name="filterUsername" Checked="filterUsername_Checked" VerticalAlignment="Center"/>
                <TextBlock Text="Filter contest " VerticalAlignment="Center"/>
                <CheckBox x:Name="filterContest" Checked="filterContest_Checked" VerticalAlignment="Center"/>
            </UniformGrid>
            <!--<StackPanel Orientation="Horizontal" Margin="0,0,0,0" Grid.Row="0" Grid.Column="1">
                
            </StackPanel>-->
            <ListView HorizontalAlignment="Stretch" Name="listViewTasksList" VerticalAlignment="Stretch" SelectionMode="Single" ItemsSource="{Binding Source={StaticResource tasks}}" IsEnabled="True" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2">
                <ListView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Copy URL" Click="MenuItem_Click_4"/>
                        <MenuItem Header="Login..." Click="MenuItem_Click_5"/>
                    </ContextMenu>
                </ListView.ContextMenu>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Solved}" Value="true">
                                <Setter Property="Background" Value="LightGreen"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Tag" DisplayMemberBinding="{Binding Path=Tag}"  Width="50" />
                        <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Path=Name}"  Width="250"/>
                        <GridViewColumn Header="User" DisplayMemberBinding="{Binding Path=Username}" Width="150"/>
                        <GridViewColumn Header="Contest" DisplayMemberBinding="{Binding Path=Contest.Name}" Width="500"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>
    </Grid>
</Window>
